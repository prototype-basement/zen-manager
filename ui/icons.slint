export component Icon inherits Rectangle {
    in property <string> path;
    in property <brush> tint;
    in property <length> size: 16px;

    width: size;
    height: size;

    Path {
        width: root.size;
        height: root.size;
        // Pinning the viewbox is required: without it Slint fits each icon's
        // own bounding box, so icons render at inconsistent scales.
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.size / 12;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
